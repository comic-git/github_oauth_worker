# Repository test and static-check runners. These execute only this repository's code.
prefix_rule(
    pattern = [".\\.venv\\Scripts\\python.exe", "-m", "pytest"],
    decision = "allow",
)
prefix_rule(
    pattern = [".\\.venv\\Scripts\\python.exe", "-m", "ruff", "check"],
    decision = "allow",
)

# Infrastructure validation runs only this repository's Pulumi program and tests.
prefix_rule(
    pattern = [".\\infra\\.venv\\Scripts\\python.exe", "-m", "pytest"],
    decision = "allow",
)
prefix_rule(
    pattern = [".\\infra\\.venv\\Scripts\\python.exe", "-m", "ruff", "check"],
    decision = "allow",
)
prefix_rule(
    pattern = [".\\infra\\.venv\\Scripts\\python.exe", "-m", "unittest"],
    decision = "allow",
)
prefix_rule(
    pattern = [".\\infra\\.venv\\Scripts\\python.exe", "-m", "compileall"],
    decision = "allow",
)

# Preview queries provider state and evaluates the local infrastructure program without changing resources.
prefix_rule(
    pattern = ["pulumi", "preview"],
    decision = "allow",
)
